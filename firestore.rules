rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 부타 다이어트
    match /buta/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 10
        && request.resource.data.weightG is int
        && request.resource.data.weightG >= 70000
        && request.resource.data.weightG <= 200000
        && request.resource.data.totalLostG is int
        && request.resource.data.totalLostG >= 0;
      allow delete: if false;
    }
    // 원숭이 서커스
    match /circus/{uid} {
      allow read: if true;
      // 누적 수입은 줄어들 수 없다 (예전 코드가 남은 기기가 오래된 기록으로 덮어쓰는 것 방지, 부동소수점 오차 1% 허용)
      allow update: if resource.data.totalEarned is number
        && request.resource.data.totalEarned >= resource.data.totalEarned * 0.99
        && request.auth != null && request.auth.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 10
        && request.resource.data.totalEarned is number
        && request.resource.data.netWorth is number
        && request.resource.data.netWorth >= 0;
      allow update: if !(resource.data.totalEarned is number)
        && request.auth != null && request.auth.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 10
        && request.resource.data.totalEarned is number
        && request.resource.data.totalEarned >= 0
        && request.resource.data.netWorth is number
        && request.resource.data.netWorth >= 0;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 10
        && request.resource.data.totalEarned is number
        && request.resource.data.totalEarned >= 0
        && request.resource.data.netWorth is number
        && request.resource.data.netWorth >= 0;
      allow delete: if false;
    }
    // 온라인 오목 로비 (대기 중인 방 목록, 방장이 8초마다 hb 갱신)
    match /omok_rooms/{code} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'hb', 'playing'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 10
        && request.resource.data.hb is number
        && request.resource.data.playing is bool;
      allow delete: if true;
    }
    // 사과 뒤집기 대결 로비 (오목과 동일한 구조)
    match /apple_rooms/{code} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'hb', 'playing'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 10
        && request.resource.data.hb is number
        && request.resource.data.playing is bool;
      allow delete: if true;
    }
    // 카트 레이서 로비 (오목과 동일한 구조)
    match /kart_rooms/{code} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'hb', 'playing'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 10
        && request.resource.data.hb is number
        && request.resource.data.playing is bool;
      allow delete: if true;
    }
    // 카트 레이서 맵별 최고 랩 기록 (문서 ID: 맵__닉네임, 기록은 갱신만 가능)
    match /kart_records/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['map', 'nick', 'time'])
        && request.resource.data.map in ['russia', 'china', 'spain', 'usa', 'canada', 'italy', 'monaco', 'germany', 'australia']
        && request.resource.data.nick is string
        && request.resource.data.nick.size() > 0
        && request.resource.data.nick.size() <= 10
        && id == request.resource.data.map + '__' + request.resource.data.nick
        && request.resource.data.time is int
        && request.resource.data.time >= 8000
        && request.resource.data.time <= 600000;
      allow update: if request.resource.data.keys().hasOnly(['map', 'nick', 'time'])
        && request.resource.data.map == resource.data.map
        && request.resource.data.nick == resource.data.nick
        && request.resource.data.time is int
        && request.resource.data.time >= 8000
        && request.resource.data.time < resource.data.time;
      allow delete: if false;
    }
  }
}
